{
  "name": "blooper-desktop",
  "productName": "blooper",
  "version": "0.1.0",
  "description": "Your agents and devices, connected locally",
  "author": "blooper contributors",
  "license": "MIT",
  "main": "main.cjs",
  "scripts": {
    "build:runtime": "node build-runtime.cjs",
    "start": "npm run build:runtime && electron .",
    "pack": "npm run build:runtime && electron-builder --dir",
    "dist": "npm run build:runtime && electron-builder --publish never",
    "test": "node --test test/*.test.cjs"
  },
  "dependencies": {
    "electron-updater": "6.8.12"
  },
  "devDependencies": {
    "electron": "45.3.4",
    "electron-builder": "26.18.1"
  },
  "build": {
    "appId": "com.blooper.desktop",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "vault.cjs",
      "ui/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "bin",
        "to": "runtime"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "Connects your paired blooper devices on the same Wi-Fi network."
      },
      "icon": "ui/icon.icns"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "verifyUpdateCodeSignature": true,
      "icon": "ui/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "chengyaolee",
        "repo": "blooper"
      }
    ]
  },
  "overrides": {
    "minimatch@9": "^11.0.1",
    "minimatch@10": "^11.0.1"
  }
}
